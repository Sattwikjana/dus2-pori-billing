# Login credentials for the billing app.
# Set these in Vercel → Project → Settings → Environment Variables.
SHOP_USERNAME=dus2pori
SHOP_PASSWORD=change-this-to-a-strong-password

# Any long random string. Signs the login cookie.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# Postgres connection string. On Vercel, add Neon from the Storage tab and this
# is injected automatically. Leave it unset to keep all data on-device only.
DATABASE_URL=
